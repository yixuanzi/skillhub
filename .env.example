# SkillHub local runtime configuration for Aegis Portal OIDC.
# Copy to .env and provide OIDC_CLIENT_SECRET through a local secret store.
OIDC_ISSUER=http://127.0.0.1:8080
OIDC_BACKCHANNEL_URL=http://host.docker.internal:8000
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1/api/v1/sso/callback
OIDC_POST_LOGIN_REDIRECT=/sso/callback
OIDC_SECURE_COOKIE=false

# Signs every login token. Required: the server refuses to start with a
# placeholder or a key shorter than 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Resources may only target publicly routable addresses by default. List the
# internal targets the gateway is allowed to call, as a JSON array of CIDRs/IPs,
# hostnames or "*.suffix" wildcards, e.g. ["10.20.0.0/16","*.corp.example.com"].
GATEWAY_ALLOWED_HOSTS=[]
