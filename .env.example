# SkillHub local runtime configuration for Aegis Portal OIDC.
# Copy to .env and provide OIDC_CLIENT_SECRET through a local secret store.
OIDC_ISSUER=http://127.0.0.1:8080
OIDC_BACKCHANNEL_URL=http://host.docker.internal:8000
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1/api/v1/sso/callback
OIDC_POST_LOGIN_REDIRECT=/sso/callback
OIDC_SECURE_COOKIE=false
