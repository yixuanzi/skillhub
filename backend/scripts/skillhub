#!/bin/bash

# SkillHub CLI Script
# Usage: skillhub [res_type] [res_name] [options]

# CLI version. Keep in sync with scripts/skillhub.py's SKILLHUB_VERSION.
SKILLHUB_VERSION="1.0.1"

# SkillHub API URL (configure this to your SkillHub instance)
SKILLHUB_URL="{PLACEHOLDER_SKILLHUB_URL}"


# Check for curl dependency
if ! command -v /usr/bin/curl >/dev/null 2>&1 && ! command -v curl >/dev/null 2>&1; then
    echo "Error: curl is not installed or not found in /usr/bin/curl" >&2
    echo "Please install curl to use this script:" >&2
    echo "  - macOS:   brew install curl" >&2
    echo "  - Ubuntu/Debian: sudo apt-get install curl" >&2
    echo "  - CentOS/RHEL: sudo yum install curl" >&2
    echo "  - Fedora: sudo dnf install curl" >&2
    exit 1
fi

# Use /usr/bin/curl if available, otherwise fall back to curl in PATH
CURL_BIN="/usr/bin/curl"
if [ ! -x "$CURL_BIN" ]; then
    CURL_BIN="curl"
fi

# Find grep, sed, python3 for portability
GREP_BIN="grep"
SED_BIN="sed"
PYTHON_BIN="python3"

# Try to use /usr/bin variants if available for consistency
[ -x "/usr/bin/grep" ] && GREP_BIN="/usr/bin/grep"
[ -x "/usr/bin/sed" ] && SED_BIN="/usr/bin/sed"
[ -x "/usr/bin/python3" ] && PYTHON_BIN="/usr/bin/python3"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Print error message
error() {
    echo -e "${RED}Error: $1${NC}" >&2
    exit 1
}

# Print success message
success() {
    echo -e "${GREEN}$1${NC}"
}

# Print warning message
warning() {
    echo -e "${YELLOW}Warning: $1${NC}"
}

# Print info message
info() {
    echo -e "${BLUE}$1${NC}"
}

# Show version
show_version() {
    printf "skillhub %s\n" "$SKILLHUB_VERSION"
}

# Show help and usage
show_help() {
    printf "${GREEN}SkillHub CLI Tool v${SKILLHUB_VERSION}${NC}\n\n"
    printf "${BLUE}DESCRIPTION${NC}\n"
    printf "    A command-line interface for interacting with SkillHub gateway resources.\n"
    printf "    Supports three resource types: third-party APIs, gateway resources, and MCP servers,\n"
    printf "    plus a dedicated 'composio' command for the built-in Composio integration.\n\n"
    printf "${BLUE}USAGE${NC}\n"
    printf "    skillhub list [search_term]              List all skills or search by name\n"
    printf "    skillhub install [skill_name]           Install a skill to local directory\n"
    printf "    skillhub getme                          Get current user info\n"
    printf "    skillhub [res_type] [res_name] [options] Invoke a resource\n"
    printf "    skillhub composio [search|schema|exec] [options] Call the composio integration\n"
    printf "    skillhub -h\n"
    printf "    skillhub --version\n"
    printf "    skillhub\n\n"
    printf "${BLUE}LIST COMMAND${NC}\n"
    printf "    skillhub list [search_term] [-page <number>]\n\n"
    printf "    Lists all available skills or searches by skill name.\n"
    printf "    Outputs: JSON with skill summary (id, name, description, category, tags, etc.)\n\n"
    printf "${BLUE}INSTALL COMMAND${NC}\n"
    printf "    skillhub install [skill_name]\n\n"
    printf "    Downloads a skill from SkillHub and saves it to ./[skill_name]/SKILL.md\n\n"
    printf "${BLUE}GETME COMMAND${NC}\n"
    printf "    skillhub getme [-token <token>]\n\n"
    printf "    Returns the current authenticated user's profile information.\n\n"
    printf "${BLUE}COMPOSIO COMMAND${NC}\n"
    printf "    skillhub composio search \"<use case>\" [--known-fields '<k:v,...>']   COMPOSIO_SEARCH_TOOLS\n"
    printf "    skillhub composio schema <TOOL_SLUG> [TOOL_SLUG ...]                 COMPOSIO_GET_TOOL_SCHEMAS\n"
    printf "    skillhub composio exec <TOOL_SLUG> [--inputs '<json object>']        COMPOSIO_MULTI_EXECUTE_TOOL\n"
    printf "    skillhub composio exec --tools '<json array>'                        COMPOSIO_MULTI_EXECUTE_TOOL (batch)\n\n"
    printf "    Calls the single, globally-configured 'composio' resource (type=composio) -\n"
    printf "    there can only ever be one such resource in SkillHub. Still requires -token /\n"
    printf "    SKILLHUB_API_KEY for SkillHub auth as usual; the Composio account itself\n"
    printf "    (COMPOSIO_API_KEY / COMPOSIO_USER_ID) is configured on that resource, not per CLI user.\n\n"
    printf "    Workflow: search -> schema -> exec. A tool slug is only valid if a search\n"
    printf "    returned it - never invent one. search often already returns the full\n"
    printf "    input_schema, in which case the schema step can be skipped. Check the\n"
    printf "    toolkit's connection status from search; it must be ACTIVE before exec.\n\n"
    printf "    search  use_case      the quoted positional argument (one action per search)\n"
    printf "            known_fields  optional; comma-separated key:value identifier hints,\n"
    printf "                          e.g. --known-fields 'project_key:VMS'. Short, stable\n"
    printf "                          identifiers only - never free-form text.\n"
    printf "    schema  tool_slugs    one or more slugs, space-separated\n"
    printf "    exec    tool_slug     the positional argument; --inputs holds that tool's\n"
    printf "                          own arguments as a JSON object (omitted -> {})\n"
    printf "            --tools       batch form, a JSON array of\n"
    printf "                          {\"tool_slug\": \"...\", \"arguments\": {...}} (max 50),\n"
    printf "                          executed in parallel. Mutually exclusive with the\n"
    printf "                          positional slug and --inputs.\n\n"
    printf "${BLUE}ARGUMENTS${NC}\n"
    printf "    res_type        Resource type (required): third, gateway, mcp\n"
    printf "    res_name        Resource name (required): name of the resource to call\n\n"
    printf "${BLUE}OPTIONS${NC}\n"
    printf "    -method <method>    HTTP method: GET, POST, PUT, DELETE (required for third/gateway)\n"
    printf "    -path <path>        Resource access path (required for gateway)\n"
    printf "    -mcptool <tool>     MCP tool/method name (required for mcp)\n"
    printf "    -inputs <json>      JSON string of parameters (optional)\n"
    printf "                        Also spelled --inputs for 'composio exec'\n"
    printf "    --known-fields <s>  Identifier hints for 'composio search' (optional)\n"
    printf "    --tools <json>      JSON array of tools for 'composio exec' batch form (optional)\n"
    printf "    -token <token>      SkillHub API token (optional, defaults to SKILLHUB_API_KEY env var)\n"
    printf "    -timeout <seconds>  Request timeout in seconds (optional, default: 30)\n"
    printf "    -page <number>      Page number for list command (optional)\n"
    printf "    -v                  Verbose mode: show curl command being executed (optional)\n"
    printf "    --version           Print the CLI version and exit\n\n"
    printf "${BLUE}EXAMPLES${NC}\n\n"
    printf "    ${YELLOW}# List all skills${NC}\n"
    printf "    skillhub list\n\n"
    printf "    ${YELLOW}# Search skills by name${NC}\n"
    printf "    skillhub list weather\n"
    printf "    skillhub list ai -token your-api-token\n"
    printf "    skillhub list ai -page 2\n\n"
    printf "    ${YELLOW}# Install a skill${NC}\n"
    printf "    skillhub install weather-skill\n"
    printf "    skillhub install customer-support -token your-api-token\n\n"
    printf "    ${YELLOW}# Third-party API call${NC}\n"
    printf "    skillhub third weather-api -method GET -inputs '{\"city\":\"Beijing\"}'\n"
    printf "    skillhub third user-service -method POST -inputs '{\"name\":\"John\",\"email\":\"john@example.com\"}'\n\n"
    printf "    ${YELLOW}# Gateway resource call${NC}\n"
    printf "    skillhub gateway my-api -method GET -path users/123\n"
    printf "    skillhub gateway backend-api -method POST -path users -inputs '{\"name\":\"Jane\"}'\n"
    printf "    skillhub gateway backend-api -method PUT -path users/123 -inputs '{\"name\":\"Jane Updated\"}'\n"
    printf "    skillhub gateway backend-api -method DELETE -path users/123\n\n"
    printf "    ${YELLOW}# MCP server call${NC}\n"
    printf "    skillhub mcp my-mcp-server -mcptool test -inputs '{\"name\":\"weather_tool\",\"arguments\":{\"location\":\"Tokyo\"}}'\n"
    printf "    skillhub mcp my-mcp-server -mcptool tool_name2\n\n"
    printf "    ${YELLOW}# Composio meta-tool calls (search -> schema -> exec)${NC}\n"
    printf "    skillhub composio search \"search issues in jira created recently\" --known-fields 'project_key:VMS'\n"
    printf "    skillhub composio schema JIRA_SEARCH_ISSUES\n"
    printf "    skillhub composio schema JIRA_SEARCH_ISSUES SLACK_SEND_MESSAGE\n"
    printf "    skillhub composio exec JIRA_SEARCH_ISSUES --inputs '{\"project_key\":\"VMS\",\"created_after\":\"-5d\"}'\n"
    printf "    skillhub composio exec --tools '[{\"tool_slug\":\"JIRA_SEARCH_ISSUES\",\"arguments\":{\"project_key\":\"VMS\"}},{\"tool_slug\":\"SLACK_SEND_MESSAGE\",\"arguments\":{\"channel\":\"general\",\"text\":\"done\"}}]'\n\n"
    printf "    ${YELLOW}# Get current user info${NC}\n"
    printf "    skillhub getme\n"
    printf "    skillhub getme -token your-api-token\n\n"
    printf "    ${YELLOW}# Using custom token${NC}\n"
    printf "    skillhub third weather-api -method GET -inputs '{\"city\":\"Shanghai\"}' -token your-api-token-here\n\n"
    printf "${BLUE}ENVIRONMENT VARIABLES${NC}\n"
    printf "    SKILLHUB_API_KEY   Default API token if -token is not provided\n"
    printf "${BLUE}RESOURCE TYPES${NC}\n"
    printf "    third       Third-party API resources (requires -method)\n"
    printf "    gateway     Gateway resources with path support (requires -method and -path)\n"
    printf "    mcp         MCP server resources (requires -mcptool)\n"
    printf "    composio    Built-in Composio integration, singleton, invoked via 'skillhub composio ...' (see COMPOSIO COMMAND)\n\n"
    printf "${BLUE}AUTHENTICATION${NC}\n"
    printf "    Token priority:\n"
    printf "    1. Token provided via -token option\n"
    printf "    2. SKILLHUB_API_KEY environment variable\n"
    printf "    3. Error if neither is available\n"
}

# Get current user info from SkillHub
getme_user() {
    # Get token: use provided token, fallback to env var
    if [ -z "$TOKEN" ]; then
        TOKEN="$SKILLHUB_API_KEY"
    fi

    if [ -z "$TOKEN" ]; then
        error "No authentication token found. Please provide via -token option or set SKILLHUB_API_KEY environment variable"
    fi

    local api_url="$SKILLHUB_URL/api/v1/auth/me/"

    local response
    response=$($CURL_BIN --max-time $TIMEOUT -sS -X GET "$api_url" \
        -H "accept: application/json" \
        -H "Authorization: Bearer $TOKEN")

    if [ $? -ne 0 ]; then
        error "Failed to fetch user info from API"
    fi

    echo "$response" | $PYTHON_BIN -m json.tool 2>/dev/null || echo "$response"
}

# Install a skill from SkillHub to local directory
install_skill() {
    local skill_name="$1"

    if [ -z "$skill_name" ]; then
        error "install command requires a skill name"
    fi

    # Get token: use provided token, fallback to env var
    if [ -z "$TOKEN" ]; then
        TOKEN="$SKILLHUB_API_KEY"
    fi

    # if [ -z "$TOKEN" ]; then
    #     error "No authentication token found. Please provide via -token option or set SKILLHUB_API_KEY environment variable"
    # fi

    info "Installing skill: $skill_name"

    # Define storage locations
    local skillhub_home="$HOME/.agents/skills"
    local actual_dir="$skillhub_home/$skill_name"
    # local link_dir="./skills/$skill_name"

    # Create skillhub home directory if not exists
    if [ ! -d "$skillhub_home" ]; then
        mkdir -p "$skillhub_home" || error "Failed to create directory: $skillhub_home"
    fi

    # Create actual skill directory in ~/skillhub
    if [ -d "$actual_dir" ]; then
        warning "Directory $actual_dir already exists. Overwriting SKILL.md"
    else
        mkdir -p "$actual_dir" || error "Failed to create directory: $actual_dir"
    fi

    # Fetch skill content from API (install=true returns plain text)
    local api_url="$SKILLHUB_URL/api/v1/skills/$skill_name/?install=true"
    info "Fetching skill from: $api_url"

    local http_code content
    content=$($CURL_BIN --max-time $TIMEOUT -sS -w "\n%{http_code}" -X GET "$api_url" \
        -H "accept: text/plain" \
        -H "Authorization: Bearer $TOKEN")

    if [ $? -ne 0 ]; then
        error "Failed to fetch skill from API"
    fi

    # Extract HTTP status code (last line) and body (everything before)
    local body
    http_code=$(echo "$content" | tail -1)
    body=$(echo "$content" | $SED_BIN '$d')

    if [ "$http_code" != "200" ]; then
        if [ -n "$body" ]; then
            error "Failed to install skill '$skill_name' (HTTP $http_code): $body"
        else
            error "Failed to install skill '$skill_name' (HTTP $http_code). Check if the skill exists and you have access."
        fi
    fi

    # Check if content is empty
    if [ -z "$body" ]; then
        error "Failed to get skill content. Check if skill exists and you have access."
    fi

    # Write to actual location
    echo "$body" > $actual_dir/SKILL.md || error "Failed to write to $actual_dir/SKILL.md"

    # Create local ./skills directory if not exists
    # mkdir -p "./skills" 2>/dev/null || true

    # Create or update symbolic link
    # if [ -L "$link_dir" ]; then
    #     # Link exists, remove it first
    #     rm "$link_dir" || warning "Failed to remove existing symlink: $link_dir"
    # elif [ -e "$link_dir" ]; then
    #     # A file/directory exists (not a symlink), back it up
    #     warning "Backing up existing $link_dir to $link_dir.backup"
    #     mv "$link_dir" "$link_dir.backup" || error "Failed to backup existing directory: $link_dir"
    # fi

    # Create symbolic link
    # ln -s "$actual_dir" "$link_dir" || warning "Failed to create symlink: $link_dir -> $actual_dir"

    success "Skill installed successfully:"
    echo "  Actual: $actual_dir"
    # if [ -L "$link_dir" ]; then
    #     echo "  Link:   $link_dir -> $actual_dir"
    # fi
}

# Call a composio backend endpoint and pretty-print the JSON response
composio_call() {
    local endpoint="$1"
    local body="$2"

    if [ -z "$TOKEN" ]; then
        TOKEN="$SKILLHUB_API_KEY"
    fi
    if [ -z "$TOKEN" ]; then
        error "No authentication token found. Please provide via -token option or set SKILLHUB_API_KEY environment variable"
    fi

    local api_url="$SKILLHUB_URL/api/v1/gateway/composio/$endpoint"

    if [ $VERBOSE -eq 1 ]; then
        info "$CURL_BIN --max-time $TIMEOUT -sS -L -X 'POST' '$api_url' -H 'Content-Type: application/json' -H 'Authorization: Bearer $TOKEN' -d '$body'"
    fi

    local response
    response=$($CURL_BIN --max-time "$TIMEOUT" -sS -L -X POST "$api_url" \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer $TOKEN" \
        -d "$body")

    if [ $? -ne 0 ]; then
        error "Failed to call composio endpoint: $endpoint"
    fi

    echo "$response" | $PYTHON_BIN -m json.tool 2>/dev/null || echo "$response"
}

# Build request bodies with python so the search text / JSON inputs never
# need shell-escaping.
composio_search_body() {
    USE_CASE="$1" KNOWN_FIELDS="$2" "$PYTHON_BIN" - <<'PY'
import json
import os

body = {"use_case": os.environ["USE_CASE"]}
known_fields = os.environ.get("KNOWN_FIELDS", "")
if known_fields:
    body["known_fields"] = known_fields
print(json.dumps(body))
PY
}

# Slugs arrive newline-delimited; tool slugs never contain newlines.
composio_schema_body() {
    TOOL_SLUGS="$(printf '%s\n' "$@")" "$PYTHON_BIN" - <<'PY'
import json
import os

slugs = [s for s in os.environ["TOOL_SLUGS"].split("\n") if s]
print(json.dumps({"tool_slugs": slugs}))
PY
}

composio_exec_body() {
    TOOL_NAME="$1" INPUTS_JSON="$2" "$PYTHON_BIN" - <<'PY'
import json
import os
import sys

tool_name = os.environ["TOOL_NAME"]
raw = os.environ.get("INPUTS_JSON", "")

if raw:
    try:
        arguments = json.loads(raw)
    except json.JSONDecodeError as exc:
        print(f"Error: invalid JSON for --inputs: {exc}", file=sys.stderr)
        sys.exit(1)
    if not isinstance(arguments, dict):
        print("Error: --inputs must be a JSON object", file=sys.stderr)
        sys.exit(1)
else:
    arguments = {}

print(json.dumps({"tools": [{"tool_slug": tool_name, "arguments": arguments}]}))
PY
}

# Batch form: --tools '[{"tool_slug": "...", "arguments": {...}}, ...]'
composio_exec_batch_body() {
    TOOLS_JSON="$1" "$PYTHON_BIN" - <<'PY'
import json
import os
import sys

def fail(message):
    print(f"Error: {message}", file=sys.stderr)
    sys.exit(1)

try:
    tools = json.loads(os.environ["TOOLS_JSON"])
except json.JSONDecodeError as exc:
    fail(f"invalid JSON for --tools: {exc}")

if not isinstance(tools, list) or not tools:
    fail('--tools must be a non-empty JSON array, e.g. \'[{"tool_slug":"X","arguments":{}}]\'')
if len(tools) > 50:
    fail(f"--tools accepts at most 50 entries, got {len(tools)}")

normalized = []
for index, tool in enumerate(tools):
    if not isinstance(tool, dict):
        fail(f"--tools[{index}] must be a JSON object")
    slug = tool.get("tool_slug")
    if not isinstance(slug, str) or not slug:
        fail(f'--tools[{index}] requires a non-empty "tool_slug"')
    arguments = tool.get("arguments", {})
    if not isinstance(arguments, dict):
        fail(f'--tools[{index}].arguments must be a JSON object')
    normalized.append({"tool_slug": slug, "arguments": arguments})

print(json.dumps({"tools": normalized}))
PY
}

# List skills from SkillHub
list_skills() {
    local search_term="$1"
    local page="$2"

    # Get token: use provided token, fallback to env var
    if [ -z "$TOKEN" ]; then
        TOKEN="$SKILLHUB_API_KEY"
    fi

    # Build API URL with search and page parameters if provided
    local api_url="$SKILLHUB_URL/api/v1/skills/"
    local query_params=""

    if [ -n "$search_term" ]; then
        query_params="?search=$search_term"
        info "Searching for skills matching: $search_term"
    else
        info "Listing all skills"
    fi

    if [ -n "$page" ]; then
        if [ -n "$query_params" ]; then
            query_params="$query_params&page=$page"
        else
            query_params="?page=$page"
        fi
        info "Page: $page"
    fi

    api_url="$api_url$query_params"
    info "Fetching skills from $api_url"

    # Fetch skills from API
    local response
    response=$($CURL_BIN --max-time $TIMEOUT -sS -X GET "$api_url" \
        -H "accept: application/json" \
        -H "Authorization: Bearer $TOKEN")

    if [ $? -ne 0 ]; then
        error "Failed to fetch skills from API"
    fi

    # Check for error response
    if echo "$response" | $GREP_BIN -q '"detail"'; then
        error "API Error: $response"
    fi

    # Pretty print JSON response
    echo "$response" | $PYTHON_BIN -m json.tool 2>/dev/null || echo "$response"
}

# Parse command line arguments
RES_TYPE=""
RES_NAME=""
METHOD=""
RPATH=""
MCPTOOL=""
INPUTS=""
TOKEN=""
TIMEOUT=30  # Default timeout: 30 seconds
VERBOSE=0   # Verbose mode: 0=quiet, 1=show curl command

# Check for version flag. Deliberately not -v: that is verbose mode.
if [ "$1" = "--version" ] || [ "$1" = "-version" ]; then
    show_version
    exit 0
fi

# Check if no arguments or -h flag
if [ $# -eq 0 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    show_help
    exit 0
fi

# Check for install command
if [ "$1" = "install" ]; then
    shift
    # Parse options for install command
    while [ $# -gt 0 ]; do
        case "$1" in
            -token)
                if [ $# -lt 2 ]; then
                    error "Option -token requires a value"
                fi
                TOKEN="$2"
                shift 2
                ;;
            -timeout)
                if [ $# -lt 2 ]; then
                    error "Option -timeout requires a value"
                fi
                TIMEOUT="$2"
                shift 2
                ;;
            -*)
                # Error on unexpected dash-prefixed options
                error "Unknown option for install command: $1"
                ;;
            *)
                # First non-option argument is the skill name
                install_skill "$1"
                exit 0
                ;;
        esac
    done
    error "install command requires a skill name"
fi

# Check for getme command
if [ "$1" = "getme" ]; then
    shift
    while [ $# -gt 0 ]; do
        case "$1" in
            -token)
                if [ $# -lt 2 ]; then
                    error "Option -token requires a value"
                fi
                TOKEN="$2"
                shift 2
                ;;
            -timeout)
                if [ $# -lt 2 ]; then
                    error "Option -timeout requires a value"
                fi
                TIMEOUT="$2"
                shift 2
                ;;
            *)
                error "Unknown option for getme command: $1"
                ;;
        esac
    done
    getme_user
    exit 0
fi

# Check for list command
if [ "$1" = "list" ]; then
    shift
    # Parse options for list command
    search_term=""
    page=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -token)
                if [ $# -lt 2 ]; then
                    error "Option -token requires a value"
                fi
                TOKEN="$2"
                shift 2
                ;;
            -timeout)
                if [ $# -lt 2 ]; then
                    error "Option -timeout requires a value"
                fi
                TIMEOUT="$2"
                shift 2
                ;;
            -page)
                if [ $# -lt 2 ]; then
                    error "Option -page requires a value"
                fi
                # Validate page is a number
                if ! echo "$2" | command $GREP_BIN -qE '^[0-9]+$'; then
                    error "Option -page requires a numeric value, got: $2"
                fi
                page="$2"
                shift 2
                ;;
            -*)
                # Error on unexpected dash-prefixed options
                error "Unknown option for list command: $1"
                ;;
            *)
                # First non-option argument is the search term
                list_skills "$1" "$page"
                exit 0
                ;;
        esac
    done
    # No search term provided, list all skills
    list_skills "" "$page"
    exit 0
fi

# Check for composio command
if [ "$1" = "composio" ]; then
    shift
    if [ $# -eq 0 ]; then
        error "composio command requires a subcommand: search, schema, exec"
    fi
    SUBCMD="$1"
    shift

    ARGS=()
    KNOWN_FIELDS=""
    TOOLS_JSON=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -token)
                if [ $# -lt 2 ]; then
                    error "Option -token requires a value"
                fi
                TOKEN="$2"
                shift 2
                ;;
            -timeout)
                if [ $# -lt 2 ]; then
                    error "Option -timeout requires a value"
                fi
                TIMEOUT="$2"
                shift 2
                ;;
            --inputs|-inputs)
                if [ $# -lt 2 ]; then
                    error "Option --inputs requires a value"
                fi
                INPUTS="$2"
                shift 2
                ;;
            --known-fields|-known-fields)
                if [ $# -lt 2 ]; then
                    error "Option --known-fields requires a value"
                fi
                KNOWN_FIELDS="$2"
                shift 2
                ;;
            --tools|-tools)
                if [ $# -lt 2 ]; then
                    error "Option --tools requires a value"
                fi
                TOOLS_JSON="$2"
                shift 2
                ;;
            -v)
                VERBOSE=1
                shift
                ;;
            -*)
                error "Unknown option for composio command: $1"
                ;;
            *)
                ARGS+=("$1")
                shift
                ;;
        esac
    done

    case "$SUBCMD" in
        search)
            if [ ${#ARGS[@]} -eq 0 ]; then
                error 'composio search requires a use case, e.g. skillhub composio search "send an email"'
            fi
            if [ ${#ARGS[@]} -gt 1 ]; then
                error "composio search takes a single use case - quote it as one argument"
            fi
            if [ -n "$INPUTS" ]; then
                error "--inputs is only valid for 'composio exec'"
            fi
            if [ -n "$TOOLS_JSON" ]; then
                error "--tools is only valid for 'composio exec'"
            fi
            BODY=$(composio_search_body "${ARGS[0]}" "$KNOWN_FIELDS") || exit 1
            composio_call "search" "$BODY"
            ;;
        schema)
            if [ ${#ARGS[@]} -eq 0 ]; then
                error "composio schema requires at least one tool name, e.g. skillhub composio schema JIRA_SEARCH_ISSUES"
            fi
            if [ -n "$KNOWN_FIELDS" ]; then
                error "--known-fields is only valid for 'composio search'"
            fi
            if [ -n "$INPUTS" ]; then
                error "--inputs is only valid for 'composio exec'"
            fi
            if [ -n "$TOOLS_JSON" ]; then
                error "--tools is only valid for 'composio exec'"
            fi
            BODY=$(composio_schema_body "${ARGS[@]}") || exit 1
            composio_call "schema" "$BODY"
            ;;
        exec)
            if [ -n "$KNOWN_FIELDS" ]; then
                error "--known-fields is only valid for 'composio search'"
            fi
            if [ -n "$TOOLS_JSON" ]; then
                # Batch form - the positional slug and --inputs belong to the single form.
                if [ ${#ARGS[@]} -gt 0 ]; then
                    error "composio exec takes either a tool name or --tools, not both"
                fi
                if [ -n "$INPUTS" ]; then
                    error "--inputs applies to a single tool name; put arguments inside --tools instead"
                fi
                BODY=$(composio_exec_batch_body "$TOOLS_JSON") || exit 1
            else
                if [ ${#ARGS[@]} -eq 0 ]; then
                    error "composio exec requires a tool name, e.g. skillhub composio exec JIRA_SEARCH_ISSUES --inputs '{...}'"
                fi
                if [ ${#ARGS[@]} -gt 1 ]; then
                    error "composio exec takes one tool name - use --tools '[{...}]' to run several"
                fi
                BODY=$(composio_exec_body "${ARGS[0]}" "$INPUTS") || exit 1
            fi
            composio_call "exec" "$BODY"
            ;;
        *)
            error "Unknown composio subcommand '$SUBCMD'. Must be one of: search, schema, exec"
            ;;
    esac
    exit 0
fi

# Parse res_type (first positional argument)
RES_TYPE="$1"
shift

# Validate res_type
if [ "$RES_TYPE" != "third" ] && [ "$RES_TYPE" != "gateway" ] && [ "$RES_TYPE" != "mcp" ]; then
    error "Invalid res_type '$RES_TYPE'. Must be one of: third, gateway, mcp"
fi

# Parse res_name (second positional argument)
if [ $# -eq 0 ]; then
    error "res_name is required"
fi
RES_NAME="$1"
shift

# Parse options
while [ $# -gt 0 ]; do
    case "$1" in
        -method)
            if [ $# -lt 2 ]; then
                error "Option -method requires a value"
            fi
            METHOD="$2"
            shift 2
            ;;
        -path)
            if [ $# -lt 2 ]; then
                error "Option -path requires a value"
            fi
            RPATH="$2"
            shift 2
            ;;
        -mcptool)
            if [ $# -lt 2 ]; then
                error "Option -mcptool requires a value"
            fi
            MCPTOOL="$2"
            shift 2
            ;;
        -inputs)
            if [ $# -lt 2 ]; then
                error "Option -inputs requires a value"
            fi
            INPUTS="$2"
            shift 2
            ;;
        -token)
            if [ $# -lt 2 ]; then
                error "Option -token requires a value"
            fi
            TOKEN="$2"
            shift 2
            ;;
        -timeout)
            if [ $# -lt 2 ]; then
                error "Option -timeout requires a value"
            fi
            TIMEOUT="$2"
            shift 2
            ;;
        -v)
            VERBOSE=1
            shift
            ;;
        *)
            error "Unknown option: $1"
            ;;
    esac
done

# Get token: use provided token, fallback to env var
if [ -z "$TOKEN" ]; then
    TOKEN="$SKILLHUB_API_KEY"
fi

if [ -z "$TOKEN" ]; then
    error "No authentication token found. Please provide via -token option or set SKILLHUB_API_KEY environment variable"
fi

# Override SKILLHUB_URL from environment if set
# if [ -n "$SKILLHUB_URL" ] && [ "$SKILLHUB_URL" != "http://localhost:8000" ]; then
#     info "Using custom SKILLHUB_URL: $SKILLHUB_URL"
# fi

# Validate required parameters based on res_type
case "$RES_TYPE" in
    third)
        if [ -z "$METHOD" ]; then
            error "res_type 'third' requires -method option (GET, POST, PUT, DELETE)"
        fi
        # Validate method and convert to uppercase (portable way)
        case "$METHOD" in
            [gG][eE][tT])   METHOD="GET" ;;
            [pP][oO][sS][tT]) METHOD="POST" ;;
            [pP][uU][tT])    METHOD="PUT" ;;
            [dD][eE][lL][eE][tT][eE]) METHOD="DELETE" ;;
            *) error "Invalid method '$METHOD'. Must be one of: GET, POST, PUT, DELETE" ;;
        esac
        ;;
    gateway)
        if [ -z "$METHOD" ]; then
            error "res_type 'gateway' requires -method option (GET, POST, PUT, DELETE)"
        fi
        if [ -z "$RPATH" ]; then
            error "res_type 'gateway' requires -path option"
        fi
        # Validate method and convert to uppercase (portable way)
        case "$METHOD" in
            [gG][eE][tT])   METHOD="GET" ;;
            [pP][oO][sS][tT]) METHOD="POST" ;;
            [pP][uU][tT])    METHOD="PUT" ;;
            [dD][eE][lL][eE][tT][eE]) METHOD="DELETE" ;;
            *) error "Invalid method '$METHOD'. Must be one of: GET, POST, PUT, DELETE" ;;
        esac
        ;;
    mcp)
        if [ -z "$MCPTOOL" ]; then
            error "res_type 'mcp' requires -mcptool option"
        fi
        ;;
esac

# Convert METHOD to lowercase for URL path (portable way)
METHOD_LOWER=""
case "$METHOD" in
    GET)    METHOD_LOWER="get" ;;
    POST)   METHOD_LOWER="post" ;;
    PUT)    METHOD_LOWER="put" ;;
    DELETE) METHOD_LOWER="delete" ;;
esac

# Convert JSON to URL query parameters using Python for correct parsing/encoding
json_to_query_params() {
    local json="$1"

    JSON_TO_ENCODE="$json" "$PYTHON_BIN" - <<'PY'
import json
import os
import sys
from urllib.parse import urlencode

raw = os.environ.get("JSON_TO_ENCODE", "")

try:
    data = json.loads(raw)
except json.JSONDecodeError as exc:
    print(f"Error: invalid JSON for -inputs: {exc}", file=sys.stderr)
    sys.exit(1)

if not isinstance(data, dict):
    print("Error: -inputs must be a JSON object", file=sys.stderr)
    sys.exit(1)

print(urlencode(data, doseq=True))
PY
}

# Build URL and execute curl based on res_type
case "$RES_TYPE" in
    third)
        URL="$SKILLHUB_URL/api/v1/gateway/$RES_NAME/$METHOD_LOWER"
        #info "Calling: $METHOD $URL"

        # Build curl command with timeout
        CURL_CMD="$CURL_BIN --max-time $TIMEOUT -sS -L -X '$METHOD' '$URL'"
        CURL_CMD="$CURL_CMD -H 'Content-Type: application/json'"
        CURL_CMD="$CURL_CMD -H 'Authorization: Bearer $TOKEN'"

        # Add inputs as query params for GET/DELETE, or as body for other methods
        if [ -n "$INPUTS" ]; then
            if [ "$METHOD" = "GET" ] || [ "$METHOD" = "DELETE" ]; then
                # Convert JSON to URL-encoded query parameters
                QUERY_PARAMS=$(json_to_query_params "$INPUTS")
                if [ -n "$QUERY_PARAMS" ]; then
                    URL="$URL?$QUERY_PARAMS"
                    CURL_CMD="$CURL_BIN --max-time $TIMEOUT -sS -L -X '$METHOD' '$URL' -H 'Content-Type: application/json' -H 'Authorization: Bearer $TOKEN'"

                fi
            else
                CURL_CMD="$CURL_CMD -d '$INPUTS'"
            fi
        fi

        # Execute curl command
        if [ $VERBOSE -eq 1 ]; then
            info "$CURL_CMD"
        fi
        eval $CURL_CMD
        ;;

    gateway)
        # Remove leading slash from RPATH if present to avoid double slashes
        CLEAN_PATH="${RPATH#/}"
        URL="$SKILLHUB_URL/api/v1/gateway/$RES_NAME/$CLEAN_PATH"
        #info "Calling: $METHOD $URL"
        # Build curl command with timeout
        CURL_CMD="$CURL_BIN --max-time $TIMEOUT -sS -L -X '$METHOD' '$URL'"
        CURL_CMD="$CURL_CMD -H 'Content-Type: application/json'"
        CURL_CMD="$CURL_CMD -H 'Authorization: Bearer $TOKEN'"

        # Add inputs as query params for GET, or as body for other methods
        if [ -n "$INPUTS" ]; then
            if [ "$METHOD" = "GET" ] || [ "$METHOD" = "DELETE" ]; then
                # Add inputs as query parameters (URL encode the JSON string)
                QUERY_PARAMS=$(json_to_query_params "$INPUTS")
                if [ -n "$QUERY_PARAMS" ]; then
                    URL="$URL?$QUERY_PARAMS"
                    CURL_CMD="$CURL_BIN --max-time $TIMEOUT -sS -L -X '$METHOD' '$URL' -H 'Content-Type: application/json' -H 'Authorization: Bearer $TOKEN'"
                fi
            else
                CURL_CMD="$CURL_CMD -d '$INPUTS'"
            fi
        fi

        # Execute curl command
        if [ $VERBOSE -eq 1 ]; then
            info "$CURL_CMD"
        fi
        eval $CURL_CMD
        ;;

    mcp)
        URL="$SKILLHUB_URL/api/v1/gateway/$RES_NAME/mcp"
        #info "Calling MCP: POST $URL (method: $MCPTOOL)"

        # Build request body
        if [ -n "$INPUTS" ]; then
            REQUEST_BODY="{\"method\": \"${MCPTOOL}\", \"params\": ${INPUTS}}"
        else
            REQUEST_BODY="{\"method\": \"${MCPTOOL}\", \"params\": {}}"
        fi

        # Execute curl command with timeout
        CURL_CMD="$CURL_BIN --max-time $TIMEOUT -sS -L -X 'POST' '$URL' -H 'Content-Type: application/json' -H 'Authorization: Bearer $TOKEN' -d '$REQUEST_BODY'"
        if [ $VERBOSE -eq 1 ]; then
            info "$CURL_CMD"
        fi
        eval $CURL_CMD
        ;;
esac
